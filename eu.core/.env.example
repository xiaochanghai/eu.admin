# Use these names as process environment variables or User Secrets. The default
# development launch profile loads only allowlisted non-secret metadata from
# .env. Never commit .env. P5 resolves the exact runtime credential names
# directly without adding their values to application configuration.

# P1 host startup settings
AgentPlatform__ServiceName=agent-api
AgentPlatform__ModelEndpoint=https://replace-with-a-compatible-model-endpoint/v1
AgentPlatform__ModelCredentialAlias=alias:development-agent-model
AgentPlatform__ExposeOpenApi=false

# P9 authentication. Supply these as process environment variables or User
# Secrets outside Development; the restricted local .env loader intentionally
# does not import authentication settings. Authority must be HTTPS. The default
# Development launch uses an explicit loopback-only bypass instead.
AgentAuthentication__Authority=https://replace-with-your-oidc-authority
AgentAuthentication__Audience=eu-core-agent
AgentAuthentication__TenantId=replace-with-host-tenant-id
AgentAuthentication__RequireHttpsMetadata=true
AgentAuthentication__PermissionClaimType=permission
AgentAuthentication__TenantClaimType=tenant_id
AgentAuthentication__UserIdClaimType=sub

# P2 public model-profile identifiers shown by the Agent editor. Add __1,
# __2, ... for more IDs. Never put a key, credential alias, URL, connection
# string or absolute path here.
AgentControl__ModelProfileIds__0=replace-with-public-model-profile-id

# Agent local file storage. Relational Agent data uses the shared SqlSugar
# connection selected by MainDB/DBS; AgentStorage contains no database setting.
AgentStorage__SkillRootPath=wwwroot/skills

# P4 MCP discovery. HTTP/HTTPS origins and ports are denied unless explicitly
# allowlisted. Credential values are never stored here; MCP records keep only
# alias: identifiers. Stdio remains disabled; configure exact command/argument
# profiles through AgentMcp__StdioProfiles__N__Command/Arguments__N when required;
# production Profiles also require AgentMcp__StdioProfiles__N__ExecutableSha256.
AgentMcp__AllowedHosts__0=127.0.0.1
AgentMcp__AllowedPorts__0=3001
AgentMcp__AllowDevelopmentHttp=true
AgentMcp__EnableStdio=false
AgentMcp__ConnectionTimeoutSeconds=15
AgentMcp__DiscoveryTimeoutSeconds=15

# Controlled Business Query forwarding (P10 Task 8). Keep disabled until the
# exact synchronized Server, Catalog, Schema hash, and signing key are ready.
BusinessQueryForwarding__Enabled=false
# BusinessQueryForwarding__ServerCode=business-query
# BusinessQueryForwarding__ToolName=query_business_data
# BusinessQueryForwarding__Origin=https://business-query.internal:8443/
# BusinessQueryForwarding__Issuer=eu-core-agent
# BusinessQueryForwarding__Audience=eu-core-business-query
# BusinessQueryForwarding__SigningKeyAlias=alias:business-query-context
# BusinessQueryForwarding__CatalogRevision=1
# BusinessQueryForwarding__CatalogHash=<64 lowercase hex>
# BusinessQueryForwarding__ToolSchemaHash=<64 lowercase hex>
# BusinessQueryForwarding__TokenLifetimeSeconds=45
# BusinessQueryForwarding__AllowDevelopmentHttp=false
# Production only: AGENT_BUSINESS_QUERY_SIGNING_KEY_BUSINESS_QUERY_CONTEXT=<base64 32-64 bytes>
# Production only: EU_CORE_AGENT_BUSINESS_QUERY_SERVICE_TOKEN=<at least 32 random characters>
# The development SQLite demo does not need a business database credential.

# Authoritative Business Query result retention in Agent Host SQLite.
BusinessQueryResultRetention__RetentionDays=30
BusinessQueryResultRetention__MaximumResultBytes=1048576
BusinessQueryResultRetention__MaximumConversationBytes=10485760
BusinessQueryResultRetention__ExpiredResultAction=RedactPresentation

# P5 bounded Agent execution. Runtime credential values remain only in the
# ignored local .env or process environment and are never returned by APIs.
AgentExecution__ModelTimeoutSeconds=120
AgentExecution__ToolCallTimeoutSeconds=60
AgentExecution__MaximumToolResultBytes=1048576
AgentExecution__MaximumModelOutputBytes=32768
AgentExecution__MaximumModelOutputEvents=4096
AgentExecution__MaximumModelInputBytes=262144
AgentExecution__MaximumToolArgumentBytes=32768
AgentExecution__MaximumInternalToolResultBytes=32768
AgentExecution__MaximumInternalToolCalls=32
AgentExecution__MaximumMcpToolCalls=32
AgentExecution__MaximumApprovedToolResultBytes=30000

# P12-5 optional model-based advisory evaluation. It is disabled by default,
# requires explicit per-request consent, and never replaces deterministic gates.
AgentEvaluation__EnableModelJudge=false
AgentEvaluation__ModelJudgeMaximumCases=20
AgentEvaluation__ModelJudgeTimeoutSeconds=300

# Authenticated Prometheus text export at /metrics. Disabled by default and
# protected by the agent.audit.read permission when enabled.
AgentDeployment__MetricsEnabled=false

# P16 fixed-window per-identity API protection. Health, static UI, OpenAPI, and
# the protected metrics endpoint are outside this limiter.
AgentRateLimit__Enabled=true
AgentRateLimit__GeneralPermitLimit=600
AgentRateLimit__ExpensivePermitLimit=30
AgentRateLimit__WindowSeconds=60

# P18 instance-wide admission control for model, orchestration, and evaluation
# starts. Saturated requests fail fast instead of waiting in an in-process queue.
AgentCapacity__Enabled=true
AgentCapacity__MaximumConcurrentExpensiveRequests=8
AgentCapacity__RetryAfterSeconds=1

# P19 durable retry safety for non-streaming expensive POST requests when the
# caller supplies an Idempotency-Key. Streaming chat uses its run/event recovery APIs.
AgentIdempotency__Enabled=true
AgentIdempotency__RetentionHours=24
AgentIdempotency__MaximumCachedResponseBytes=4194304

# P17 remains same-origin when no origins are configured. Production origins
# must be exact HTTPS authorities; wildcards, credentials, paths, and queries fail startup.
# AgentHttpSecurity__AllowedOrigins__0=https://agent-admin.example.com
AgentHttpSecurity__AllowDevelopmentHttpOrigins=false

# P8 unified-entry execution budgets and timeouts. These settings are
# non-secret and apply globally within each entry run.
UnifiedEntry__MaximumDelegationDepth=4
UnifiedEntry__MaximumChildCalls=8
UnifiedEntry__MaximumOrchestrationCalls=4
UnifiedEntry__MaximumMcpCalls=20
UnifiedEntry__EntryTimeoutSeconds=300
UnifiedEntry__ChildTimeoutSeconds=120
UnifiedEntry__MaximumInternalPayloadBytes=32768
UnifiedEntry__MaximumMcpResultBytes=4194304

# P11 Human-in-the-loop approval. Production requires a random 32-byte key,
# base64 encoded. Do not copy the development-only key from appsettings.
# AGENT_TOOL_APPROVAL_PAYLOAD_KEY=<base64 exactly 32 bytes>

# P0 compatibility capability declarations (non-secret)
AGENT_MODEL_ENDPOINT=https://replace-with-qwen-or-deepseek-compatible-endpoint/v1
AGENT_MODEL_DEFAULT_ID=replace-with-tested-model
AGENT_MODEL_SUPPORTS_IMAGES=false
AGENT_MODEL_SUPPORTS_PDF=false
